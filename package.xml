<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_opencv</name>
  <version>0.0.0</version>
  <description>OpenCV + ArUco + PlanSys2 actions for Experimental Robotics</description>

  <maintainer email="carmine.recchiuto@dibris.unige.it">root</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>


  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>image_transport</depend>
  <depend>cv_bridge</depend>
  <depend>opencv</depend>
  <depend>nav_msgs</depend>



  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>


  <depend>rclcpp_action</depend>
  <depend>nav2_msgs</depend>
  <depend>plansys2_executor</depend>


  <exec_depend>plansys2_bringup</exec_depend>
  <exec_depend>plansys2_lifecycle_manager</exec_depend>
  <exec_depend>plansys2_terminal</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
